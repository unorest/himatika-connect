#--------------------------------------------------------------------
# HIMATIKA Connect - Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan kredensial database
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = himatika_db
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port     = 3306

#--------------------------------------------------------------------
# WHATSAPP NOTIFICATION GATEWAY (FONNTE / WA API)
#--------------------------------------------------------------------
# Aktifkan (true/false) untuk mengirim notifikasi instan ke nomor pengurus/grup WA
whatsapp.enabled  = false
# Dapatkan Token API gratis di https://fonnte.com
whatsapp.token    = ""
# Nomor WhatsApp tujuan (contoh: 08123456789 atau ID grup 1203630xxx@g.us)
# Bisa lebih dari 1 nomor dengan dipisah tanda koma (0812...,0813...)
whatsapp.target   = ""
whatsapp.provider = "fonnte"

